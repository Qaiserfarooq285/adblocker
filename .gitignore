# Large / generated data - never committed
data/
runs/
outputs/
logs/
input/
!docs/

# Model weights (downloaded or trained; multi-MB to multi-GB)
models/
*.pt
*.onnx
*.tflite
*.ts

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.swp

# Local config overrides (machine-specific, regenerated by the notebook)
config.local.yaml

# Anything accidentally holding a credential
*.pem
*.key
.env
